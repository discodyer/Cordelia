# NoneBot Configuration
# Copy this file to .env and fill in your values

# Environment (prod/dev)
ENVIRONMENT=dev

# Server port (default 8080)
PORT=8080

driver=~fastapi+~httpx
LOCALSTORE_USE_CWD=true

# Telegram Bot Token (get from @BotFather)
telegram_bots = [{"token": "000000000:AAAAxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxx"}]

# Superusers (comma-separated user IDs)
SUPERUSERS=["123456789"]

# Command prefixes
COMMAND_START=["/"]

# Eat What Plugin Whitelist
# Group chat IDs (negative numbers for Telegram supergroups)
EATWHAT_GROUP_WHITELIST=["-1001234567890"]
# User IDs for private chat whitelist
EATWHAT_USER_WHITELIST=["123456789"]

# Eat What Plugin Schedule
# Time to send "吃什么" (24-hour format, e.g., "11:30" for 11:30 AM)
EATWHAT_SCHEDULE_TIMES=["11:30", "17:30"]
# Probability to randomly trigger "吃什么" (0.0 to 1.0, e.g., 0.01 means 1%)
EATWHAT_RANDOM_PROBABILITY=0.01

# APScheduler Configuration
AP_SCHEDULER_AUTOSTART=true
AP_SCHEDULER_LOG_LEVEL=info
